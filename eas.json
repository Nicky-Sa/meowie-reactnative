{
  "cli": {
    "version": ">= 16.3.2",
    "appVersionSource": "remote"
  },
  "build": {
    "internal-development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "internal-development-ios-simulator": {
      "extends": "internal-development",
      "ios": {
        "simulator": true
      }
    },
    "internal-preview": {
      "environment": "preview",
      "distribution": "internal"
    },
    "testflight-preview": {
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": true
    },
    "testflight-production": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}

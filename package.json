{
  "name": "meowie-reactnative",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "start": "expo start --clear --dev-client",
    "prebuild": "expo prebuild --clean",
    "eas-build:internal-dev:android": "eas env:pull --environment development && eas build --platform android --profile internal-development --clear-cache --local --output=./local-builds/dev/android/$(date +\"%Y-%m-%d_%H-%M\").apk",
    "eas-build:internal-dev:ios-simulator": "eas env:pull --environment development && eas build --platform ios --profile internal-development-ios-simulator --clear-cache --local --output=./local-builds/dev/ios-simulator/$(date +\"%Y-%m-%d_%H-%M\").tar.gz",
    "eas-build:internal-dev:ios-device": "eas env:pull --environment development && eas build --platform ios --profile internal-development --clear-cache --local --output=./local-builds/dev/ios-device/$(date +\"%Y-%m-%d_%H-%M\").tar.gz",
    "eas-build:internal-preview:android": "eas env:pull --environment preview && eas build --platform android --profile internal-preview --clear-cache --local --output=./local-builds/preview/android/$(date +\"%Y-%m-%d_%H-%M\").apk",
    "eas-build:internal-preview:ios-device": "eas env:pull --environment preview && eas build --platform ios --profile internal-preview --clear-cache --local --output=./local-builds/preview/ios-device/$(date +\"%Y-%m-%d_%H-%M\").tar.gz",
    "eas-build:testflight-preview": "eas env:pull --environment preview && eas build --platform ios --profile testflight-preview --clear-cache --local --non-interactive --output=./local-builds/testflight/preview/meowie.ipa",
    "eas-build:testflight-production": "eas env:pull --environment production && eas build --platform ios --profile testflight-production --clear-cache --local --non-interactive --output=./local-builds/testflight/production/meowie.ipa",
    "eas-build-post-install": "node ./scripts/eas-build-post-install.mjs",
    "test": "jest --watchAll",
    "lint": "eslint",
    "eas-update": "eas update --auto && npx sentry-expo-upload-sourcemaps dist",
    "generate-figma-variables": "npx ts-node figma/processor.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prepare": "husky",
    "firebase-emulators": "npx firebase emulators:start"
  },
  "dependencies": {
    "@expo-google-fonts/lato": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@hookform/resolvers": "^5.2.2",
    "@ptomasroos/react-native-multi-slider": "^2.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native/virtualized-lists": "^0.82.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@rn-primitives/portal": "^1.3.0",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.2.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "expo": "~54.0.27",
    "expo-application": "~7.0.7",
    "expo-build-properties": "~1.0.9",
    "expo-constants": "^18.0.10",
    "expo-dev-client": "^6.0.16",
    "expo-device": "~8.0.9",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.9",
    "expo-haptics": "^15.0.7",
    "expo-image": "~3.0.10",
    "expo-linking": "~8.0.10",
    "expo-localization": "~17.0.7",
    "expo-navigation-bar": "^5.0.9",
    "expo-router": "~6.0.13",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "^31.0.10",
    "expo-status-bar": "^3.0.8",
    "expo-symbols": "^1.0.7",
    "expo-system-ui": "^6.0.8",
    "expo-updates": "^29.0.12",
    "expo-video": "^3.0.12",
    "expo-web-browser": "^15.0.8",
    "iconoir-react-native": "^7.11.0",
    "jotai": "^2.15.0",
    "jotai-immer": "^0.4.1",
    "lodash": "^4.17.21",
    "lottie-react-native": "^7.3.4",
    "nativewind": "^4.2.1",
    "posthog-react-native": "^4.10.4",
    "posthog-react-native-session-replay": "^1.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.66.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gradients": "^2.1.1",
    "react-native-image-colors": "^2.5.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-mmkv": "^4.1.0",
    "react-native-reanimated": "~4.1.3",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-youtube-iframe": "2.3.0",
    "semver": "^7.7.3",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "use-immer": "^0.11.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@eslint/js": "^9.38.0",
    "@sentry/cli": "^2.57.0",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.9.1",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.13",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "overrides": {
    "iconoir-react-native": {
      "react": "$react"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}

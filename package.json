{
  "name": "meowie-reactnative",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --clear",
    "prebuild": "expo prebuild --clean",
    "eas-build:dev:android": "eas env:pull --environment development && eas build --platform android --profile development --clear-cache --local --output=./local-builds/dev/android/$(date +\"%Y-%m-%d_%H-%M\").apk",
    "eas-build:dev:ios-simulator": "eas env:pull --environment development && eas build --platform ios --profile ios-simulator --clear-cache --local --output=./local-builds/dev/ios-simulator/$(date +\"%Y-%m-%d_%H-%M\").tar.gz",
    "eas-build:dev:ios-device": "eas env:pull --environment development && eas build --platform ios --profile development --clear-cache --local --output=./local-builds/dev/ios-device/$(date +\"%Y-%m-%d_%H-%M\").tar.gz",
    "eas-build:prev:ios-device": "eas env:pull --environment preview && eas build --platform ios --profile preview --clear-cache --local --output=./local-builds/prev/ios-device/$(date +\"%Y-%m-%d_%H-%M\").tar.gz",
    "eas-build-post-install": "node ./scripts/eas-build-post-install.mjs",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "eas-update": "eas update --auto && npx sentry-expo-upload-sourcemaps dist",
    "generate-figma-variables": "npx ts-node figma/processor.ts",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/lato": "^0.3.0",
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "^5.1.4",
    "@ptomasroos/react-native-multi-slider": "^2.2.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.3.13",
    "@react-navigation/native": "^7.1.9",
    "@rn-primitives/portal": "^1.2.0",
    "@sentry/react-native": "~6.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "expo": "53.0.9",
    "expo-application": "~6.1.4",
    "expo-build-properties": "~0.14.6",
    "expo-constants": "^17.1.6",
    "expo-dev-client": "^5.1.8",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.10",
    "expo-font": "~13.3.1",
    "expo-haptics": "^14.1.4",
    "expo-image": "~2.1.7",
    "expo-linear-gradient": "^14.1.4",
    "expo-linking": "^7.1.5",
    "expo-localization": "~16.1.5",
    "expo-navigation-bar": "^4.2.4",
    "expo-router": "~5.0.7",
    "expo-splash-screen": "^0.30.8",
    "expo-status-bar": "^2.2.3",
    "expo-symbols": "^0.4.4",
    "expo-system-ui": "^5.0.7",
    "expo-updates": "^0.28.13",
    "expo-web-browser": "^14.1.6",
    "jotai": "^2.12.4",
    "jotai-immer": "^0.4.1",
    "lodash": "^4.17.21",
    "nativewind": "^4.1.23",
    "posthog-react-native": "^3.15.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-css-interop": "^0.1.22",
    "react-native-gesture-handler": "~2.25.0",
    "react-native-image-colors": "^2.4.0",
    "react-native-reanimated": "~3.17.5",
    "react-native-reanimated-carousel": "^4.0.2",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.10.0",
    "react-native-svg": "15.12.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "react-native-youtube-iframe": "^2.3.0",
    "rive-react-native": "^9.3.1",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "use-immer": "^0.11.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@sentry/cli": "^2.45.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.18",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "eslint": "^9.27.0",
    "eslint-config-expo": "^9.2.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.5",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.0.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}

{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "appAssociation": "NONE"
  },
  "emulators": {
    "auth": {
      "host": "192.168.1.186",
      "port": 9099
    },
    "hosting": {
      "port": 6001
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}

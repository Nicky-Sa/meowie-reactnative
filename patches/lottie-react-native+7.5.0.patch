+// A reused view keeps the last Lottie's props and animation, so a splash with autoPlay
+// would play the next file once. Start from defaults like a new view.
+- (void)prepareForRecycle
+{
+    [super prepareForRecycle];
+
+    static const auto defaultProps = std::make_shared<const LottieAnimationViewProps>();
+    _props = defaultProps;
+
+    _view = [LottieContainerView new];
+    _view.delegate = self;
+    self.contentView = _view;
+}
